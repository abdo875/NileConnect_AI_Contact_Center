# ============================================================
# NileConnect AI Contact Center — Backend Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/nileconnect

# --- JWT Auth ---
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
APP_NAME=NileConnect AI Contact Center
DEBUG=true
ENVIRONMENT=development

# --- CORS (comma-separated allowed origins) ---
ALLOWED_ORIGINS=http://localhost:8501

# --- File Storage ---
UPLOAD_DIR=uploads

# --- Frontend URL ---
FRONTEND_URL=http://localhost:8501

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
