# ============================================================
# NileConnect AI Contact Center — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# Never commit .env files to version control.
# ============================================================

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nileconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ----- Backend (FastAPI) -----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----- Frontend (Streamlit) -----
BACKEND_URL=http://localhost:8000

# ----- File Storage -----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# ----- Phase 2 — AI (not used in Phase 1) -----
OPENAI_API_KEY=
EMBEDDING_MODEL=
VECTOR_DB_URL=

# ----- Phase 3 — Telephony (not used in Phase 1) -----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
